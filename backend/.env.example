# Sao chep thanh backend/.env roi dien gia tri that. KHONG commit file .env.

# Postgres rieng cua project, dung bang `docker compose up -d` trong thu muc backend/.
# Cong 5433 (khong phai 5432) va host 127.0.0.1 — xem chu thich trong docker-compose.yml.
DATABASE_URL=postgresql+asyncpg://chemgame:chemgame@127.0.0.1:5433/chemgame

# openssl rand -hex 32
JWT_SECRET=
SESSION_SECRET=

# Google Cloud Console > Credentials > OAuth client ID (Web)
# Authorized redirect URI phai dang ky DUNG chuoi nay:
#   http://localhost:8001/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Vite dev server
FRONTEND_URL=http://localhost:5173
# Cong 8000 tren may nay dang bi app khac chiem -> backend dung 8001
BACKEND_URL=http://localhost:8001
COOKIE_SECURE=false
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30

# Test tich hop (pytest -m integration). De trong thi test bi skip.
TEST_DATABASE_URL=postgresql+asyncpg://chemgame:chemgame@127.0.0.1:5433/chemgame_test
